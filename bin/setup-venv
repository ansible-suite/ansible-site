#!/bin/bash

### Creates or updates the Python virtual environment
# Performs the following actions:
#   - creates the venv if it does not exist yet
#   - installs and/or upgrades PIP packages from 'requirements.txt',
#     or 'requirements_$ANSIBLESITE_PROFILE' if the setup mode is defined
#     using the ANSIBLESITE_PROFILE env variable or the first command-line argument


## Enable stricter execution
set -eu -o pipefail


## Activate the project shell environment
# shellcheck disable=SC1091
source "$(dirname "$(readlink -f "$0")")/activate"


## Create the virtual environment, if it does not exist yet
if [[ ! -d "$ANSIBLESITE_VENV" ]]; then
    python3 -m venv "$ANSIBLESITE_VENV"
fi


## Activate the virtual environment
# shellcheck disable=SC1091
source "$ANSIBLESITE_VENV/bin/activate"


## Install PIP packages from a requirements file

# get the file name
if [[ -n "$ANSIBLESITE_PROFILE" ]]; then
    REQUIREMENTS_FILE="requirements_$ANSIBLESITE_PROFILE.txt"
else
    REQUIREMENTS_FILE="requirements.txt"
fi

# run 'pip' to install and/or upgrade the packages
pip install -U -r "$ANSIBLESITE/$REQUIREMENTS_FILE"
