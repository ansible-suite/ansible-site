#!/bin/bash

### The ansible-site shell environment activation script
# This script must be run with 'source' or '.' from an existing bash or zsh shell, not executed directly.
# The ANSIBLESITE_PROFILE or the first command-line argument to this script (or to the calling script, if not overridden) specifies the profile used.
# Performs the following actions in the sourcing shell:
#   - sources variables from .env, .env.local, .env.$ANSIBLESITE_PROFILE and .env.$ANSIBLESITE_PROFILE.local
#   - activates the Python venv, if it exists, by sourcing 'venv/bin/activate'
#   - adds the 'bin' and 'external_bin' directories to the PATH environment variable
#   - sets the ANSIBLE_CONFIG environment variable to point to the 'ansible.cfg' file of the workspace
# In addition, it declares a deactivation function which reverts these actions.


## Get information about the shell environment

# Determine the shell the script is running in
if [[ "${BASH_VERSINFO+x}" ]]; then
    _ANSIBLESITE_SHELL=bash
elif [[ "${ZSH_VERSION+x}" ]]; then
    _ANSIBLESITE_SHELL=zsh
else
    echo "This environment activation script supports running in bash and zsh." >&2
    exit 1
fi

# Determine the path of this script
case "$_ANSIBLESITE_SHELL" in
    bash)
        _ANSIBLESITE_SCRIPT="${BASH_SOURCE[0]}"
        ;;
    zsh)
        # shellcheck disable=SC2296
        _ANSIBLESITE_SCRIPT="${(%):-%x}"
esac


## Exit if executed directly
if [[ "$_ANSIBLESITE_SCRIPT" = "$0" ]]; then
    echo "$0: This script must be called with 'source' or '.' from an existing shell." >&2
    exit 1
fi


## Declare public functions

# Helper function to add compatibility of sourcing dynamically-generated shell code
# in older bash version
if [[ "$_ANSIBLESITE_SHELL" = 'bash' && "$BASH_VERSINFO" -le 3 ]]; then
    source_generated() {

        # Declare variables
        local SCRIPT_FD SCRIPT_TEMP RC

        # Process arguments
        SCRIPT_FD="$1"
        shift

        # Create a private temporary file
        SCRIPT_TEMP="$(mktemp "${XDG_RUNTIME_DIR-"${TMPDIR-"/tmp"}"}"/bash-source-generated.XXXXXX)"

        # Put the contents of the dynamically-generated file to the temporary file
        cat "$SCRIPT_FD" > "$SCRIPT_TEMP"

        # Source the temporary file and save exit status
        RC=0
        # shellcheck disable=SC1090
        source "$SCRIPT_TEMP" "$@" || RC=$?

        # Remove the temporary file
        rm "$SCRIPT_TEMP"

        # Return with the exit code of the sourced script
        return $RC

    }
else
    source_generated() {
        # shellcheck disable=SC1090
        source "$@"
    }
fi


## Declare internal functions

# Helper functions to get and set a variable using indirect expansion
case "$_ANSIBLESITE_SHELL" in
    bash)
        _get_indirect() {
            printf '%s' "${!1:-}"
        }
        _set_indirect() {
            printf -v "$1" '%s' "$2"
        }
        ;;
    zsh)
        _get_indirect() {
            # shellcheck disable=SC2296
            print "${(P)${1}:-}"
        }
        _set_indirect() {
            typeset -g "$1=$2"
        }
esac

# Function that sets a variable and keeps the old value
# in a variable prefixed with _OLD_
_save_and_set_var() {
    local NAME OLD_NAME OLD_VAL NEW_VAL
    NAME="$1"
    OLD_NAME="_OLD_$NAME"
    OLD_VAL="$(_get_indirect "$NAME")"
    NEW_VAL="$2"
    if [[ "$OLD_VAL" != "$NEW_VAL" ]]; then
        _set_indirect "$OLD_NAME" "$OLD_VAL"
        _set_indirect "$NAME" "$NEW_VAL"
    fi
}

# Function that reverts a variable to its old value
# from the variable prefixed with _OLD_
_revert_saved_var() {
    local NAME OLD_NAME OLD_VAL
    NAME="$1"
    OLD_NAME="_OLD_$NAME"
    OLD_VAL="$(_get_indirect "$OLD_NAME")"
    if [[ -z "$OLD_VAL" ]]; then
        unset "$NAME"
    else
        _set_indirect "$NAME" "$OLD_VAL"
    fi
    unset "$OLD_NAME"
}

# Function that removes custom directories from PATH
_unset_path() {
    if [[ "$PATH:" == "$ANSIBLESITE_PATH:"* ]]; then
        PATH="$PATH:"
        PATH="${PATH//$ANSIBLESITE_PATH:/}"
        PATH="${PATH%:}"
        export PATH
    fi
}

# Function to load variable files
_load_vars() {
    if [[ -e "$1" ]]; then
        # shellcheck disable=SC1090
        source "$1"
    fi
}

# Internal deactivation function
_deactivate() {

    ## Revert modified environment variables

    # Remove custom directories from PATH
    _unset_path

    # Revert ANSIBLE_CONFIG
    _revert_saved_var ANSIBLE_CONFIG

    # Revert ANSIBLE_VAULT_PASSWORD_FILE
    if [[ "${_OLD_ANSIBLE_VAULT_PASSWORD_FILE+x}" ]]; then
        _revert_saved_var ANSIBLE_VAULT_PASSWORD_FILE
    fi


    ## Deactivate the Python venv, if it is activated
    if declare -f _venv_deactivate > /dev/null; then
        _venv_deactivate
    fi

}


# Define variables

# the workspace directory
ANSIBLESITE="$(realpath "$(dirname "$(readlink -f "$_ANSIBLESITE_SCRIPT")")/..")"

# the Ansible configuration file of the workspace
ANSIBLESITE_CONFIG="$ANSIBLESITE/ansible.cfg"

# whether to use the Python venv (0 for false, 1 for true)
ANSIBLESITE_USE_VENV=1

# the Python venv directory of the workspace
ANSIBLESITE_VENV="$ANSIBLESITE/.venv"

# the directory with scripts
ANSIBLESITE_BIN="$ANSIBLESITE/bin"

# the directory for downloaded utilities
ANSIBLESITE_EXTERNAL_BIN="$ANSIBLESITE/external_bin"

# the directories from the workspace to add to PATH
ANSIBLESITE_PATH="$ANSIBLESITE_BIN:$ANSIBLESITE_EXTERNAL_BIN"

# the vault password file of the workspace
ANSIBLESITE_VAULT_PASSWORD_FILE="$ANSIBLESITE/.vault_pass"


## Process arguments

# determine the profile
: "${ANSIBLESITE_PROFILE:=}"
if [[ -n "${1-}" ]]; then
    # shellcheck disable=SC2034
    ANSIBLESITE_PROFILE="$1"
fi


## Load variables from .env files
_load_vars "$ANSIBLESITE/.env"
_load_vars "$ANSIBLESITE/.env.local"
if [[ -n "$ANSIBLESITE_PROFILE" ]]; then
    _load_vars "$ANSIBLESITE/.env.$ANSIBLESITE_PROFILE"
    _load_vars "$ANSIBLESITE/.env.$ANSIBLESITE_PROFILE.local"
fi


## Activate the Python venv

# Activate only if enabled
if [[ "$ANSIBLESITE_USE_VENV" -eq 1 ]]; then

    # Activate if the venv exists and is not activated yet
    if [[ -d "$ANSIBLESITE_VENV" && "${VIRTUAL_ENV:-}" != "$ANSIBLESITE_VENV" ]]; then

        # ensure PATH does not contain custom paths
        # when activating the venv
        _unset_path

        # source the activation script
        # shellcheck disable=SC1091
        source "$ANSIBLESITE_VENV/bin/activate"

        # rename the deactivation function to '_venv_deactivate'
        # to avoid conflict with the deactivation function of this script
        source_generated <(declare -f deactivate | sed 's/deactivate/_venv_deactivate/')
        unset -f deactivate

    # ... or handle the situation when venv is required but missing
    elif [[ ! -d "$ANSIBLESITE_VENV" ]]; then

        # deactivate if previously activated by us
        if declare -f _venv_deactivate > /dev/null; then
            _venv_deactivate
        fi

        # print an informational message that the venv is missing
        if [[ "${ANSIBLESITE_SUPPRESS_VENV_WARNING:-0}" -eq 0 ]]; then
            cat <<EOF >&2
$_ANSIBLESITE_SCRIPT: WARNING: This workspace is configured to use its own Python venv,
please set it up using the 'setup' or 'setup-venv' scripts,
then re-activate the environment by calling 'source $_ANSIBLESITE_SCRIPT'.
EOF
        fi

    fi

# ... or deactivate if activated by us but now disabled
elif declare -f _venv_deactivate > /dev/null; then
    _venv_deactivate
fi


## Modify environment variables

# Add directories with executables of this workspace to PATH
if [[ "${PATH:=}:" != "$ANSIBLESITE_PATH:"* ]]; then
    export PATH="$ANSIBLESITE_PATH:$PATH"
fi

# Set the ANSIBLE_CONFIG variable to the value for this workspace ($ANSIBLESITE_CONFIG)
_save_and_set_var ANSIBLE_CONFIG "$ANSIBLESITE_CONFIG"
export ANSIBLE_CONFIG

# Set the ANSIBLE_VAULT_PASSWORD_FILE to the value for this workspace ($ANSIBLESITE_VAULT_PASSWORD_FILE)
# only if the file is present
if [[ -f "$ANSIBLESITE_VAULT_PASSWORD_FILE" ]]; then
    _save_and_set_var ANSIBLE_VAULT_PASSWORD_FILE "$ANSIBLESITE_VAULT_PASSWORD_FILE"
    export ANSIBLE_VAULT_PASSWORD_FILE
elif [[ "${_OLD_ANSIBLE_VAULT_PASSWORD_FILE+x}" ]]; then
    _revert_saved_var ANSIBLE_VAULT_PASSWORD_FILE
fi


## Declare the public deactivation function
deactivate() {

    ## Call the internal deactivation function
    _deactivate


    ## Perform cleanup

    # unset internal variables
    unset _ANSIBLESITE_SHELL
    unset _ANSIBLESITE_SCRIPT

    # unset variables
    unset ANSIBLESITE
    unset ANSIBLESITE_CONFIG
    unset ANSIBLESITE_USE_VENV
    unset ANSIBLESITE_VENV
    unset ANSIBLESITE_BIN
    unset ANSIBLESITE_EXTERNAL_BIN
    unset ANSIBLESITE_PATH
    unset ANSIBLESITE_VAULT_PASSWORD_FILE
    unset ANSIBLESITE_PROFILE

    # unset public functions
    unset -f source_generated

    # unset internal functions
    unset -f _get_indirect
    unset -f _set_indirect
    unset -f _save_and_set_var
    unset -f _revert_saved_var
    unset -f _unset_path
    unset -f _load_vars
    unset -f _deactivate

    # unset this deactivation function
    unset -f deactivate

}
