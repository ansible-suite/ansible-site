#!/bin/bash

### A generic file downloader
# Uses curl if available, with wget as a fallback

## Enable stricter execution
set -eu -o pipefail


## Process arguments

# Print usage and exit if the number of arguments is not 2
if [[ ! $# -eq 2 ]]; then
    echo "Usage: $0 <url> <target>" >&2
    exit 1
fi

# Declare variables based on arguments
url="$1"
target="$2"
target_part="$target.part" # the temporary name while downloading


## Declare a function to handle download error
handle_error() {
    local rc=$?
    rm -f "$target_part"
    return $rc
}


## Download with curl or wget to the .part file
if command -v curl >/dev/null 2>&1; then
    curl -sSfL "$url" -o "$target_part" || handle_error
elif command -v wget >/dev/null 2>&1; then
    wget "$url" -O "$target_part" || handle_error
else
    echo "$0: Neither curl nor wget found. Please install one to proceed." >&2
    exit 1
fi

## Rename the .part file to the final name
mv "$target_part" "$target"
